# Web service
SERVICE_PORT=8003
DATA_DIR=./data
# Optional API key for /api/v1/* endpoints (X-API-Key header). Leave empty to disable auth.
# NOTE: this is NOT the Telegram bot token — bot tokens are configured per-bot in the panel.
API_KEY=
DEFAULT_LANGUAGE=en
REQUEST_TIMEOUT_SECONDS=12
MAX_FEED_ENTRIES=40

# Translation (LibreTranslate runs as a compose service; MyMemory is the fallback)
LIBRETRANSLATE_URL=http://libretranslate:5000

# Auto-run all active bots every N minutes (0 = manual runs only via panel)
SCHEDULE_INTERVAL_MINUTES=30
