# Web service
SERVICE_PORT=8003
DATA_DIR=./data
# Optional API key for /api/v1/* endpoints (X-API-Key header). Leave empty to disable auth.
# NOTE: this is NOT the Telegram bot token — bot tokens are configured per-bot in the panel.
API_KEY=
DEFAULT_LANGUAGE=en
REQUEST_TIMEOUT_SECONDS=12
MAX_FEED_ENTRIES=40

# Translation (LibreTranslate runs as a compose service; MyMemory is the fallback)
LIBRETRANSLATE_URL=http://libretranslate:5000

# Automatic runs on (> 0) or off (0 = manual runs only via panel).
# How often each bot runs is set per bot in the panel ("Run every").
SCHEDULE_INTERVAL_MINUTES=30

# Only post articles published within this many hours.
MAX_ARTICLE_AGE_HOURS=36

# Mistral API key (https://console.mistral.ai/). Setting it makes Mistral write each
# post — a short summary in the channel's language, from the full article — instead
# of machine-translating the RSS teaser. Leave empty to use LibreTranslate only.
# Never enter it in the panel; it lives only in the deployment environment.
MISTRAL_API_KEY=

# Optional: Mistral model to try first (e.g. mistral-small-latest). Leave empty to
# pick automatically: large → medium → small → nemo → ministral, skipping models
# the key can't use or whose quota is used up.
MISTRAL_MODEL=

# Optional: more free providers (OpenAI-style APIs). Keys from aistudio.google.com
# (Gemini) and console.groq.com (Groq). Models default to gemini-3.5-flash and
# openai/gpt-oss-120b.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Order to try providers in; ones without a key are skipped. Empty = mistral only.
# Example: gemini,groq,mistral — Gemini writes, Groq and Mistral take over if it fails.
LLM_PROVIDERS=
# Providers for the lesson fact check. Empty = the same list starting at the second
# provider, so a different model checks the text.
LLM_CHECK_PROVIDERS=
